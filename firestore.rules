
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNCIONES DE SEGURIDAD ---
    
    // Verifica si el usuario está autenticado
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Verifica si el usuario tiene el claim de administrador en su token
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    // Obtiene los datos del perfil global del usuario desde la colección de lookup
    function getUserProfile() {
      let path = /databases/$(database)/documents/user_auth_lookup/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    // Verifica si el usuario tiene permiso para acceder a una sucursal específica
    // Un usuario solo puede acceder a su propia sucursal asignada, a menos que sea Super Admin
    // o tenga el flag 'accesoGlobal' activo en su perfil.
    function belongsToBranch(sucursalId) {
      let profile = getUserProfile();
      return isSignedIn() && (
        isSuperAdmin() || 
        (profile != null && (
          profile.accesoGlobal == true || 
          string(profile.sucursalId) == string(sucursalId)
        ))
      );
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. Aislamiento de Sucursales
    match /sucursales/{sucursalId} {
      // Lectura de info de sucursal: permitida a cualquier usuario autenticado para listados y selección entre sucursales
      allow read: if isSignedIn();
      
      // Gestión de estructura de sucursales: Operación exclusiva de Super Administrador
      allow create, update, delete: if isSuperAdmin();

      // TODAS las subcolecciones (aislamiento estricto por sucursal)
      match /{allSubPath=**} {
        allow read, write: if belongsToBranch(sucursalId);
      }
    }
    
    // 2. Correlativos Globales
    match /correlativos/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    // 3. Lookup de Autenticación (user_auth_lookup)
    match /user_auth_lookup/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      // Solo el Super Administrador puede crear o modificar estos vínculos globales.
      allow write: if isSuperAdmin();
    }

    // 4. Regla para Consultas de Grupo (collectionGroup)
    match /{path=**}/historial/{docId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (getUserProfile() != null && (
          getUserProfile().accesoGlobal == true || 
          resource.data.sucursalId == getUserProfile().sucursalId
        ))
      );
    }

    // 5. Traslados Inter-Sucursales
    match /traslados/{trasladoId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }
    
    // 6. Denegación por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
